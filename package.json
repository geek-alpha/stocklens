{
  "name": "stocklens",
  "version": "0.1.0",
  "description": "StockLens - 美股实时看盘与 AI 决策辅助终端",
  "main": "./out/main/index.js",
  "author": "StockLens",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check": "npm run typecheck && npm run build",
    "verify:market": "tsc -p tools/tsconfig.verify.json && node tools/verify-market-parse.mjs",
    "verify:board": "tsc -p tools/tsconfig.verify.json && node tools/verify-board-parse.mjs",
    "verify:board:live": "tsc -p tools/tsconfig.verify.json && node tools/verify-board-live.mjs",
    "snapshot:board": "tsc -p tools/tsconfig.verify.json && node tools/snapshot-board.mjs",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "electron-store": "^8.2.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^1.48.0",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  }
}
